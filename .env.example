# ---------------------------------------------------------------------------
# Dagara Germanist AI — environment template
# Copy to `.env` and fill in the values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Cloud AI inference (server-side only via the dev proxy) -----------------
# NVIDIA Integration API key (nvapi-...). Required for all AI generation.
VITE_NVIDIA_API_KEY=
NVIDIA_API_KEY=

# --- Cloud persistence & accounts (PocketBase) --------------------------------
# Self-hosted PocketBase instance (https://dagara.185-7-81-99.sslip.io on the
# Ulkhad VPS). Without this variable the app runs in local-only mode
# (localStorage), which is the historical behaviour.
VITE_POCKETBASE_URL=

# --- Server-only secrets -----------------------------------------------------
# Never prefix with VITE_ : anything VITE_-prefixed ships to the browser.
# PocketBase has no service-role key: admin access is reserved to the
# superuser account and must stay out of the browser bundle entirely.

# --- Error monitoring (optional) --------------------------------------------
SENTRY_DSN=

# --- Marketing site ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
