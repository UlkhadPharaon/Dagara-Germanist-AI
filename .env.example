# ---------------------------------------------------------------------------
# Dagara Germanist AI — environment template
# Copy to `.env` and fill in the values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Cloud AI inference (server-side only via the dev proxy) -----------------
# NVIDIA Integration API key (nvapi-...). Required for all AI generation.
VITE_NVIDIA_API_KEY=
NVIDIA_API_KEY=

# --- Cloud persistence & accounts (Supabase) ---------------------------------
# Without these two variables the app runs in local-only mode (localStorage),
# which is the historical behaviour.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only secrets -----------------------------------------------------
# Never prefix with VITE_ : anything VITE_-prefixed ships to the browser.
# Used only by edge/server functions for usage logging.
SUPABASE_SERVICE_ROLE_KEY=

# --- Error monitoring (optional) --------------------------------------------
SENTRY_DSN=

# --- Marketing site ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
